    margin-bottom: 35px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}

.news-detail-content {
    font-size: 1.05rem;
    color: #334155;
    line-height: 1.8;
}
.news-detail-content p { margin-bottom: 24px; }
.news-detail-content h2, .news-detail-content h3 {
    color: #0f172a;
    font-weight: 700;
    margin-top: 35px;
    margin-bottom: 15px;
}
.news-detail-content h2 { font-size: 1.5rem; }
.news-detail-content h3 { font-size: 1.25rem; }
.news-detail-content img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 20px 0;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
}

/* Sidebar widget */
.sidebar-widget {
    background-color: #fff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    border: 1px solid #f1f5f9;
