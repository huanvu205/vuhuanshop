<!-- Header Section -->
<div class="news-detail-header">
    <div class="container">
        <div class="news-detail-meta">
            <a href="<?= url('news?category=' . $news['category']) ?>" class="news-detail-category">
                <?php 
                if ($news['category'] === 'cong-nghe') echo 'Công nghệ';
                elseif ($news['category'] === 'danh-gia') echo 'Đánh giá';
                elseif ($news['category'] === 'khuyen-mai') echo 'Khuyến mãi';
                elseif ($news['category'] === 'meo-vat') echo 'Mẹo vặt';
                else echo e($news['category']);
                ?>
            </a>
            <span><i class="far fa-calendar-alt"></i><?= date('H:i, d/m/Y', strtotime($news['published_at'] ?? $news['created_at'])) ?></span>
            <span><i class="far fa-user"></i>Đăng bởi: <strong><?= e($news['author_name']) ?></strong></span>
            <span><i class="far fa-eye"></i><?= number_format($news['view_count']) ?> lượt xem</span>
        </div>
        <h1 class="news-detail-title"><?= e($news['title']) ?></h1>
    </div>
</div>

<!-- Main Section -->
<div class="container py-5">
    <div class="row g-4">
        <!-- Main Content (Left) -->
        <div class="col-lg-8">
            <article class="bg-white p-4 rounded-4 border border-light shadow-sm">
                <!-- Excerpt -->
                <?php if (!empty($news['excerpt'])): ?>
                    <p class="news-detail-excerpt"><?= e($news['excerpt']) ?></p>
                <?php endif; ?>

                <!-- Cover Image -->
                <?php if (!empty($news['featured_image'])): ?>
                    <img src="<?= productImage($news['featured_image']) ?>" class="news-detail-featured-img" alt="<?= e($news['title']) ?>">
                <?php endif; ?>

                <!-- Content -->
                <div class="news-detail-content">
                    <?= $news['content'] ?>
                </div>

                <!-- Footer share -->
                <div class="border-top mt-5 pt-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small fw-bold">Chia sẻ bài viết:</span>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<?= urlencode(currentUrl()) ?>" target="_blank" class="social-share-btn fb"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://twitter.com/intent/tweet?url=<?= urlencode(currentUrl()) ?>" target="_blank" class="social-share-btn tw"><i class="fab fa-twitter"></i></a>
                        <button onclick="navigator.clipboard.writeText('<?= currentUrl() ?>'); alert('Đã sao chép link liên kết!');" class="social-share-btn copy" title="Sao chép liên kết"><i class="fas fa-link"></i></button>
                    </div>
                </div>
            </article>
        </div>

        <!-- Sidebar Widgets (Right) -->
        <div class="col-lg-4">
            <!-- Recent News -->
            <?php if (!empty($recentNews)): ?>
                <div class="sidebar-widget">
                    <h4 class="sidebar-widget-title"><i class="far fa-newspaper"></i> Tin mới nhất</h4>
                    <div class="d-flex flex-column gap-3">
                        <?php foreach ($recentNews as $recent): ?>
                            <div class="recent-post-item">
                                <img src="<?= productImage($recent['featured_image']) ?>" class="recent-post-img" alt="Post">
                                <div>
                                    <h5 class="recent-post-title">
                                        <a href="<?= url('news/' . $recent['slug']) ?>"><?= e($recent['title']) ?></a>
                                    </h5>
                                    <span class="recent-post-date"><i class="far fa-calendar-alt me-1"></i><?= date('d/m/Y', strtotime($recent['published_at'] ?? $recent['created_at'])) ?></span>
                                </div>
                            </div>
                        <?php endforeach; ?>
                    </div>
                </div>
            <?php endif; ?>

            <!-- Promotion widget -->
            <div class="sidebar-widget">
                <h4 class="sidebar-widget-title"><i class="fas fa-shopping-bag"></i> Mua sắm tại website</h4>
