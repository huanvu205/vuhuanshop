# ============================================================
#  Mẫu cấu hình cho Vũ Huân Shop
#  Copy tệp này thành `.env` rồi điền giá trị thực tế.
#  TUYỆT ĐỐI KHÔNG commit tệp `.env` lên git.
# ============================================================

# Môi trường: local | production
APP_ENV=production

# Database (MySQL)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_NAME=webbandienthoaimoi
DB_USER=root
DB_PASS=

# Email gửi đi (dùng Mật khẩu ứng dụng, KHÔNG dùng mật khẩu đăng nhập)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-shop@gmail.com
SMTP_PASS=your-app-password-here
ADMIN_EMAIL=your-shop@gmail.com

# Gemini API (keep the real key only in the ignored .env file on the server)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GA_MEASUREMENT_ID=

# Thanh toán VNPAY (điền nếu dùng)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# Thông báo đơn hàng qua Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=

# Đăng nhập bằng Google (Google OAuth 2.0)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
