<!-- News Table -->
<div class="admin-card">
    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width:120px;">Ảnh bìa</th>
                    <th>Tiêu đề bài viết</th>
