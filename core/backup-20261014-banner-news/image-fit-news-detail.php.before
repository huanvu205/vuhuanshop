}
.sidebar-widget-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #0f172a;
    padding-bottom: 12px;
    border-bottom: 2px solid #f1f5f9;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.recent-post-item {
    display: flex;
    gap: 12px;
    margin-bottom: 16px;
}
.recent-post-item:last-child { margin-bottom: 0; }
.recent-post-img {
    width: 65px;
    height: 65px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
}
.recent-post-title {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 4px 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.recent-post-title a { color: #0f172a; text-decoration: none; transition: color 0.2s; }
.recent-post-title a:hover { color: var(--primary); }
.recent-post-date { font-size: 0.74rem; color: #64748b; }

.social-share-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: white;
